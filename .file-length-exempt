Programming/NLP/reformated.txt  # NLP pipeline stage data, one record per line
Programming/WDWR/projekt/old_code/data10000.txt  # numeric matrix, 10000 scenario rows, solver input
Programming/WDWR/projekt/R/scenarios.txt  # generated scenario vectors, one per line
Programming/WDWR/projekt/wdwr/solutions1.txt  # CPLEX MILP solver log
Programming/WDWR/projekt/wdwr/KRZYSZTOF_RUDNICKI_307585_WDWR_PROJEKT/scenarios.txt  # submitted copy of scenarios.txt, must stay byte-identical
